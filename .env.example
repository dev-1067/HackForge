# Copy to .env (git-ignored) and adjust. Real environment variables always take precedence.

# --- Database -----------------------------------------------------------------
# SQLite file (default) or PostgreSQL:
DATABASE_URL=sqlite:///data/trustjuggler.db
# DATABASE_URL=postgresql+psycopg://tj:tj@localhost:5432/tj

# Demo mode (true): at start-up the simulated riders, sessions and decisions are cleared and rebuilt.
# User accounts, the company and sign-in sessions are never cleared.
# Set false to keep everything between restarts (then the simulation lab is switched off).
TJ_RESET_ON_START=true

# --- Accounts and sessions ------------------------------------------------------
# Needed for company team members to create their own accounts at /company/register.
# Leave empty to close company sign-up (accounts can still be made with `python -m api.manage`).
TJ_COMPANY_INVITE_CODE=change-me-invite-code
TJ_COMPANY_NAME=Trust Juggler Demo Fleet
TJ_RIDER_SESSION_HOURS=168
TJ_COMPANY_SESSION_HOURS=12
# Set true when the site is served over HTTPS.
TJ_COOKIE_SECURE=false
# Optional key that lets a trusted service (the rider app) post sessions to /sessions/score.
TJ_INGEST_KEY=

# Development demo accounts: one operations user and three riders, all with the password below.
# Do NOT enable this in production.
TJ_SEED_DEMO_ACCOUNTS=true
TJ_DEMO_PASSWORD=demo-pass-123

# --- Simulation lab ---------------------------------------------------------------
TJ_LAB_ENABLED=true
TJ_LAB_RIDERS=60
TJ_LAB_HISTORY_DAYS=30
TJ_LAB_SEED=11

# --- Network ------------------------------------------------------------------------
# Browser origins allowed to call the API directly (the dev server proxies /api, so this is rarely needed).
TJ_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Use a model other than engine/models/default.json
# TJ_MODEL_PATH=model/model.json

# An extra check the rider never answers is closed after this many minutes and the account is put on hold for a person (0 = never).
TJ_STEPUP_EXPIRY_MINUTES=60
