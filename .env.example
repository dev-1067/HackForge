# Copy to .env. Everything is optional; the defaults run the demo on SQLite.

# SQLite (default) or PostgreSQL:
DATABASE_URL=sqlite:///data/trustjuggler.db
# DATABASE_URL=postgresql+psycopg://tj:tj@localhost:5432/tj

# Drop and re-seed the demo data at startup (true for the demo). Set false to keep data
# between restarts; rider baselines are then restored from the database and the lab is off.
TJ_RESET_ON_START=true

# Simulation lab
TJ_LAB_ENABLED=true
TJ_LAB_RIDERS=60
TJ_LAB_HISTORY_DAYS=30
TJ_LAB_SEED=11

# Browser origins allowed to call the API (comma separated, or *)
TJ_CORS_ORIGINS=*

# Use a model other than engine/models/default.json
# TJ_MODEL_PATH=model/model.json
